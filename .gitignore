# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# media working files
/public/media/**/*.orig.*
# scratch files scripts/compress-media.mjs writes next to its target; a killed run
# leaves them behind (e.g. cover.webp.compress-tmp.webp)
*.compress-tmp.*

# Generated from content/projects/*/media by scripts/sync-media.mjs (runs on prebuild)
/public/media

# static export output
/out
